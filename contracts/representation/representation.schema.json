{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hsie:wrb001:contract:representation:0.1",
  "title": "WRB-001 Representation Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "hsie-world-reference/0.1"
    },
    "representation_id": {
      "type": "string",
      "minLength": 1
    },
    "place_ref": {
      "type": "string",
      "minLength": 1
    },
    "space_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "representation_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "asset_ref": {
      "type": "string",
      "minLength": 1
    },
    "projection": {
      "type": "string",
      "minLength": 1
    },
    "renderer_adapter": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "integrity_digest": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 8
        },
        {
          "type": "null"
        }
      ]
    },
    "legacy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "presentation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverage": {
              "type": "string",
              "minLength": 1
            },
            "aspect_ratio": {
              "type": "string",
              "minLength": 1
            },
            "initial_view": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pitch": {
                  "type": "number"
                },
                "yaw": {
                  "type": "number"
                },
                "hfov": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "north_offset": {
                  "type": "number"
                }
              },
              "required": [
                "pitch",
                "yaw",
                "hfov",
                "north_offset"
              ]
            },
            "interaction_anchors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "anchor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interaction_kind": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pitch": {
                    "type": "number"
                  },
                  "yaw": {
                    "type": "number"
                  },
                  "target_type": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "target_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "legacy_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true,
                    "default": []
                  }
                },
                "required": [
                  "anchor_id",
                  "interaction_kind",
                  "label",
                  "pitch",
                  "yaw",
                  "target_type",
                  "target_ref",
                  "legacy_refs"
                ]
              }
            }
          },
          "required": [
            "coverage",
            "aspect_ratio",
            "initial_view",
            "interaction_anchors"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "representation_id",
    "place_ref",
    "space_ref",
    "representation_type",
    "asset_ref",
    "projection",
    "renderer_adapter",
    "version",
    "status",
    "integrity_digest",
    "legacy_refs",
    "presentation"
  ]
}
