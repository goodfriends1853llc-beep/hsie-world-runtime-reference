{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "client/**/*.ts",
    "runtime/**/*.ts",
    "contracts/**/*.ts",
    "adapters/**/*.ts",
    "tests/**/*.ts"
  ]
}
